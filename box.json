{
    "name":"commandbox-release",
    "version":"3.5.3",
    "author":"Angry Sam Productions, Inc.",
    "location":"ForgeboxStorage",
    "slug":"commandbox-release",
    "type":"commandbox-modules",
    "keywords":"release,publish,build,commandbox,forgebox,github,coldbox,cfml,changelog,semver",
    "homepage":"https://github.com/homestar9/commandbox-release",
    "documentation":"https://github.com/homestar9/commandbox-release",
    "repository":{
        "type":"git",
        "url":"https://github.com/homestar9/commandbox-release/"
    },
    "bugs":"https://github.com/homestar9/commandbox-release/issues",
    "shortDescription":"Release CFML modules and web apps with CommandBox. Check, test, build, and publish to ForgeBox or GitHub.",
    "contributors":[],
    "scripts":{
        "test":"task run taskFile=tests/Run.cfc",
        "test:fast":"task run taskFile=tests/Run.cfc :fast=true"
    },
    "devDependencies":{
        "testbox":"7.0.0+19"
    },
    "ignore":[
        "**/.*",
        "/test/",
        "/tests/",
        "/testbox/",
        "/.test-work/",
        "/plans/",
        "/release.json",
        "/commandbox-release-logo.avif",
        "/AGENTS.md",
        "/CLAUDE.md",
        "/GLOSSARY.md",
        "/build/",
        "/modules/",
        "/resources/",
        "/webpack.config.js",
        "/vite.config.js",
        "/vitest.config.js",
        "/docker-compose.yml",
        "/test-harness/",
        "/test-results/",
        "/temp/",
        "/server*.json",
        "/*.code-workspace",
        "/DEVNOTES.md",
        "/RELEASE.md",
        "/node_modules/",
        "/package.json",
        "/package-lock.json",
        "**/*.bak",
        "**/*.zip",
        "**/*.tar",
        "**/*.tar.gz",
        "**/*.tgz",
        "**/*.7z",
        "**/*.rar"
    ],
    "installPaths":{
        "testbox":"testbox/"
    }
}